# Copy to .env.local and fill in. Never commit .env.local.
# Values here are placeholders, not real credentials.
# Owner-facing inventory (which environments, who owns what): docs/operations-runbook.md.
# In Vercel, Production and Preview carry the same set; Development needs only the Firebase and brief keys.
# Local builds can use throwaway Firebase values (see .github/workflows/ci.yml).

# ── Required: public site and booking ────────────────────────────────────────
# Absolute origin used for canonicals, OG image URLs, and email links.
# Read at build time for robots.txt/sitemap.xml (redeploy after changing). Unset or
# invalid falls back to https://nottherug.com, which is not attached to this project.
PUBLIC_BASE_URL=http://localhost:3000

# Scheduling link opened after a booking inquiry is saved. If unset, intake still
# works and the customer is shown an honest next step instead.
NEXT_PUBLIC_CALENDLY_URL=

# ── Required: Firebase client (browser) ──────────────────────────────────────
# These are public by design; access is controlled by firestore.rules/storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Required: Firebase Admin (server only) ───────────────────────────────────
# Service-account credentials. FIREBASE_ADMIN_PRIVATE_KEY may be quoted and use
# literal \n escapes; lib/firebase-admin.ts normalises both.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── Required: transactional email ────────────────────────────────────────────
# RESEND_API_KEY and FOUNDER_EMAIL are required for any email. Whether RESEND_FROM_EMAIL's
# domain is verified in Resend is an owner check (docs/operations-runbook.md, A7).
RESEND_API_KEY=
# A @resend.dev sender only delivers to the account's verified address, so the
# customer confirmation is skipped in that mode.
RESEND_FROM_EMAIL=Not The Rug <onboarding@resend.dev>
FOUNDER_EMAIL=

# ── Optional: launch gate ────────────────────────────────────────────────────
# "true" temporarily redirects public pages to the launch page (307). Preview and
# development deployments always send X-Robots-Tag: noindex regardless.
LAUNCH_MODE=

# ── Optional: scheduled jobs ─────────────────────────────────────────────────
# Required in production for the daily leads digest (vercel.json). Shared secret
# checked by every /api/cron/* handler; without it those routes reject all requests.
# Secret: set it in Vercel only, never in a document.
CRON_SECRET=

# ── Optional: analytics ──────────────────────────────────────────────────────
# First-party tracking, stored in Firestore and read back by the admin
# dashboard. See docs/analytics-operations.md, and
# plans/009-full-tracking-dashboard-integration.md for how it was integrated.
#
# Master switch. Tracking is OFF unless this is exactly "true", so a preview
# deploy or a local dev server never writes into real business numbers by
# accident. Nothing is collected until you set this in production.
NEXT_PUBLIC_ANALYTICS_ENABLED=

# "true" stamps every event with mode:"test". Test events are excluded from the
# dashboard's real numbers and visible only through its Test Data view (which
# puts ?testMode=1 in the URL) — that is how a preview deploy proves collection
# works without polluting the live dataset.
NEXT_PUBLIC_ANALYTICS_TEST_MODE=

# Server-side emergency stop. "true" makes /api/track accept and discard every
# event without writing. Use this to halt collection without a redeploy of the
# client bundle; it takes effect immediately and independently of the switch
# above, which browsers may have cached.
ANALYTICS_TRACKING_DISABLED=

# ── Optional: daily brief pipeline ───────────────────────────────────────────
# Absent keys disable the brief tooling; they must not block booking or admin.
ANTHROPIC_API_KEY=
NWS_USER_AGENT=
NOT_THE_RUG_BRIEF_DATA_DIR=

# ── Optional: backup walker bench (plans/011) ────────────────────────────────
# The /walk-with-us application and the admin Backup Bench page need only the
# Firebase and Resend keys above. See docs/backup-bench.md.
#
# "true" turns on the AI summary of each application (a reading aid for Luis,
# never a score or ranking). Leave unset until counsel confirms NYC Local Law
# 144 compliance. Needs ANTHROPIC_API_KEY above.
BENCH_AI_SUMMARIES_ENABLED=
# Optional model override for that summary. Defaults to claude-opus-5-5.
BENCH_AI_MODEL=

# Not used yet: nothing in the code reads the variables below. Reserved for later phases
# so accounts can be set up ahead:
# Phase 3 SMS dispatch (Twilio number with A2P 10DLC registration).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Phase 3 delayed wave timers (Upstash QStash).
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Phase 5 background checks (Checkr).
CHECKR_API_KEY=
CHECKR_WEBHOOK_SECRET=
