{
  "name": "nextapp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:pipeline": "eslint --no-config-lookup --config eslint.pipeline.mjs not-the-rug-brief scripts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm run typecheck && npm run test",
    "brief:not-the-rug": "node not-the-rug-brief/run.js --client not-the-rug",
    "brief:not-the-rug:fresh": "node not-the-rug-brief/run.js --client not-the-rug --fresh",
    "copy:extract": "node scripts/copy/extract-copy.mjs",
    "copy:apply": "node scripts/copy/apply-copy.mjs",
    "emulators": "firebase emulators:start --only firestore,storage --project demo-not-the-rug",
    "test:rules": "vitest run tests/unit/rules-firestore.test.ts tests/unit/rules-storage.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.4.0",
    "embla-carousel-react": "^8.6.0",
    "firebase": "^12.11.0",
    "firebase-admin": "^14.4.0",
    "gsap": "^3.14.2",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.12.2",
    "sharp": "^0.35.4"
  },
  "engines": {
    "node": "24.x"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "globals": "^16.5.0",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "gaxios": {
      "uuid": "^11.1.1"
    }
  }
}
