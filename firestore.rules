rules_version = '2';

// Every read/write in this app's server routes goes through the Admin
// SDK/REST API with a service-account token, which bypasses these rules
// entirely. These rules govern only direct client-SDK access — today that is
// exactly one read: app/admin/page.tsx checking its own admins/{email} doc
// to gate the dashboard UI. Everything else is denied by default.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // No self-enrollment: admin membership is managed out-of-band (Console
    // or a trusted server process), never by a client write. The read also
    // requires a verified email, mirroring lib/server/verifyAdmin.ts: an
    // email/password account registered with someone else's address must not
    // be able to probe the whitelist.
    match /admins/{email} {
      allow read: if isSignedIn()
        && request.auth.token.email_verified == true
        && request.auth.token.email == email;
      allow write: if false;
    }

    // Lead submissions contain customer PII; the public form and the admin
    // dashboard reach this collection only through server routes.
    match /leads/{leadId} {
      allow read, write: if false;
    }

    match /photoUploads/{id} {
      allow read, write: if false;
    }

    match /photoRenders/{id} {
      allow read, write: if false;
    }

    match /generatorRenders/{id} {
      allow read, write: if false;
    }

    match /notTheRugBriefRuns/{id} {
      allow read, write: if false;
    }

    match /notTheRugBriefState/{id} {
      allow read, write: if false;
    }

    // Analytics. Public visitors never touch Firestore directly — the browser
    // POSTs to /api/track, which validates against the shared allowlist in
    // lib/analytics/events.ts and writes with the service account. Denying the
    // client SDK here is what stops a visitor forging events or reading the
    // whole traffic history; the default-deny below would cover it, but this
    // collection is the one a future contributor is most likely to assume is
    // "just counters" and open up.
    match /analytics_events/{id} {
      allow read, write: if false;
    }

    // Rate-limit counters for the public ingestion endpoint. Readable only by
    // the server; a client that could read these could measure its own budget.
    match /analyticsRateLimits/{id} {
      allow read, write: if false;
    }

    // Backup walker bench (plans/011). Applicant and walker records hold PII
    // (name, email, mobile, ZIP, resume path) and SMS threads; settings hold
    // Luis's alert phone. The public application and the admin page reach all
    // of it only through server routes with the service account, so every
    // client read and write is denied, including for signed-in admins.
    match /benchSettings/{id} {
      allow read, write: if false;
    }

    match /benchPeople/{personId} {
      allow read, write: if false;
    }

    // Callouts and their per-person offers (Phase 3). The offers subcollection
    // is spelled out because a rule on the parent does not cover it.
    match /benchCallouts/{calloutId} {
      allow read, write: if false;

      match /offers/{personId} {
        allow read, write: if false;
      }
    }

    // The atomic claim for a callout (Phase 3): exactly one server-side create
    // wins. A client that could write here could claim a shift.
    match /benchCalloutClaims/{calloutId} {
      allow read, write: if false;
    }

    match /benchMessages/{id} {
      allow read, write: if false;
    }

    match /benchShifts/{id} {
      allow read, write: if false;
    }

    // Per-IP counters for the public bench routes, readable only by the server.
    match /benchRateLimits/{id} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
